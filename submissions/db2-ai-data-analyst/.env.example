# ---------------------------------------------------------------------------
# IBM Db2 connection (placeholders only - copy to .env and fill in locally)
# docker-compose.yml also reads DB2_PASSWORD / DB2_DATABASE / DB2_PORT from here.
# ---------------------------------------------------------------------------
DB2_HOST=localhost
DB2_PORT=50000
DB2_DATABASE=ANALYST
DB2_USER=db2inst1
DB2_PASSWORD=change_me_db2_admin_password
# Set to SSL for Db2 on Cloud
DB2_SECURITY=

# Least-privilege user that executes generated SQL (SELECT on RETAIL.* only).
# setup_db.py creates it inside the Docker container. Leave blank to skip.
DB2_RO_USER=analyst_ro
DB2_RO_PASSWORD=change_me_readonly_password

# Schemas
DATA_SCHEMA=RETAIL
APP_SCHEMA=ANALYST

# ---------------------------------------------------------------------------
# Google Gemini (free key: https://aistudio.google.com/apikey)
# Without a key the app runs in offline mode (reuses verified queries from memory).
# ---------------------------------------------------------------------------
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768

# ---------------------------------------------------------------------------
# Guardrails & app
# ---------------------------------------------------------------------------
# Max Db2 optimizer estimate (timerons) allowed before a query is blocked
MAX_QUERY_COST=500000
MAX_ROWS=500
MAX_SQL_RETRIES=2
MEMORY_K=4
APP_PORT=8000
